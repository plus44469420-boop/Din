{
  "name": "puffco-desktop",
  "productName": "Puffco",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop website that serves the live Puffco app.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "build:win": "node scripts/build-win.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.puffco.desktop",
    "productName": "Puffco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Puffco"
    }
  }
}
